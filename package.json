{
  "name": "capital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @capital/web dev",
    "dev:server": "pnpm --filter @capital/server dev",
    "build": "pnpm --filter @capital/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @capital/web typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:multiplayer": "vitest run --config vitest.multiplayer.config.ts",
    "simulate": "tsx tools/simulate.ts",
    "content:validate": "tsx tools/contentValidate.ts",
    "start:server": "pnpm --filter @capital/server start",
    "bench": "tsx tools/bench.ts",
    "replay:audit": "tsx tools/replayAudit.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm content:validate && pnpm test && pnpm test:multiplayer && pnpm build"
  },
  "devDependencies": {
    "@capital/ai": "workspace:*",
    "@capital/content": "workspace:*",
    "@capital/engine": "workspace:*",
    "@capital/protocol": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.10.1"
}