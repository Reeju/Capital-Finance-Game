# Game server (apps/server). Copy to .env or export in your shell. No secrets are required for local play.
PORT=8787
# SQLite file for rooms, match snapshots and the accepted command log.
DB_PATH=./apps/server/data/capital.sqlite
# Comma-separated browser origins allowed to call the API and open sockets (the page's own origin is always allowed).
ALLOWED_ORIGINS=http://localhost:5173
# Folder with the built web app, if the server should also serve it (single-origin deployment).
STATIC_DIR=./apps/web/dist

# Web build (apps/web).
# Where `vite dev` / `vite preview` proxy /api and /ws.
CAPITAL_SERVER=http://localhost:8787
# Only for split deployments where the web app and server live on different origins.
# VITE_SERVER_URL=https://capital-server.example.com
# Base path if the web app is hosted under a sub-path.
# CAPITAL_BASE=/capital/
